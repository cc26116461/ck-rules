{
  "name": "ck-rules",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "把你的对话规矩注入每次会话，并提供执行权限档位与右侧栏状态面板。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "prompt",
    "locale",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
